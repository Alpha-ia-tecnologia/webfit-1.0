{
  "name": "webfit-individual",
  "version": "0.1.0",
  "private": true,
  "description": "WebFit — acompanhamento individual de alimentação, hidratação, hábitos e medidas, com entrada por hábitos, anamnese para personalização alimentar e agente de IA.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "scripts": {
    "check:repo": "node scripts/check-repo.mjs",
    "dev": "node --import tsx server/index.ts",
    "dev:lan": "node --import tsx server/index.ts --lan",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node --import tsx server/index.ts --production",
    "start:lan": "node --import tsx server/index.ts --production --lan",
    "preview": "node --import tsx server/index.ts --production",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "lint:react": "node node_modules/eslint/bin/eslint.js src",
    "test":"node --import tsx --test tests/*.test.ts",
    "pretest:e2e": "node node_modules/vite/bin/vite.js build",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src server tests *.json *.ts *.md",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:seed": "node --import tsx scripts/db.ts seed",
    "taco:import": "node --import tsx scripts/import-taco.ts",
    "admin": "node --import tsx scripts/admin.ts",
    "db:status":"node --import tsx scripts/db.ts status",
    "test:db": "node --import tsx --test tests/db.integration.ts tests/state-sync.integration.ts tests/auth.integration.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@langchain/core": "^1.2.10",
    "@langchain/langgraph": "^1.4.14",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^13.2.0",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.3"
  }
}
