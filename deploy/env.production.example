# Copie para deploy/.env.production (nunca vai para o git nem para a imagem) e preencha.
#   cp env.production.example .env.production && chmod 600 .env.production

# Endereço público (com https); o domínio do certificado vai em caddy.env.
WEBFIT_PUBLIC_URL=https://webfit.seudominio.com.br

# Banco PostgreSQL desta VPS (o app usa a rede do servidor: 127.0.0.1 funciona). Use a mesma porta em
# que o banco atende hoje (o banco "nutri" do desenvolvimento atende na 5442).
# Prefira o usuário restrito criado por deploy/db-role.sql.
# Formato: postgres:// + usuário + ":" + senha + "@127.0.0.1:5442/nutri" (preencha só na VPS).
DATABASE_URL=

# Pedidos ao agente por conta e por dia (o dono do servidor não tem limite).
WEBFIT_AI_DAILY_LIMIT=30

# Provedores de IA (os mesmos nomes do .env.local do computador).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FAST=
