# Configuração apenas do servidor local. Nunca coloque a chave no frontend nem neste arquivo de exemplo.
# Copie para .env.local e preencha lá. O diário e a anamnese funcionam sem um provedor de IA configurado.
# DeepSeek é o provedor principal (texto e, com modelo de visão, foto). Basta uma das chaves (DeepSeek ou OpenAI).
DEEPSEEK_API_KEY=
# Modelo de texto do DeepSeek. Se vazio, usa deepseek-chat.
DEEPSEEK_MODEL=
# Opcional: modelo do DeepSeek com entrada de imagem para fotos de refeição (use deepseek-flash). Se vazio, fotos vão para a OpenAI.
DEEPSEEK_VISION_MODEL=
# Opcional: 1 mantém o modo de raciocínio do DeepSeek (mais lento; por padrão o agente pede respostas diretas).
DEEPSEEK_THINKING=
# OpenAI: reserva quando o DeepSeek falha e único provedor para laudos em PDF.
OPENAI_API_KEY=
# Modelo principal para os especialistas (ex.: gpt-5.6-terra). Precisa aceitar imagens e PDF como entrada.
OPENAI_MODEL=
# Opcional: modelo mais rápido/barato para triagem e revisão (ex.: gpt-5.6-luna). Se vazio, usa OPENAI_MODEL.
OPENAI_MODEL_FAST=
PORT=3000
# PostgreSQL usado por npm run db:migrate / db:seed (schema webfit). Prefira sslmode=require em servidores remotos.
DATABASE_URL=
